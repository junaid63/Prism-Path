{
    "name": "junaid63/prism-path",
    "description": "PrismPath is a premium Laravel analytics, heatmap, session replay, and AI-assisted insight package.",
    "type": "library",
    "keywords": [
        "laravel",
        "analytics",
        "heatmaps",
        "session-replay",
        "prismpath",
        "google-analytics",
        "dashboard",
        "ai-insights"
    ],
    "homepage": "https://github.com/junaid63/Prism-Path",
    "license": "MIT",
    "authors": [
        {
            "name": "Junaid",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/junaid63/Prism-Path/issues",
        "source": "https://github.com/junaid63/Prism-Path"
    },
    "autoload": {
        "psr-4": {
            "PrismPath\\Analytics\\": "src/",
            "PrismPath\\Analytics\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PrismPath\\Analytics\\PrismPathServiceProvider"
            ],
            "aliases": {
                "PrismPath": "PrismPath\\Analytics\\Facades\\PrismPath"
            }
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

