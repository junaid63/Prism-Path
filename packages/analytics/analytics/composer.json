{
    "name": "aetherpulse/prismpath",
    "description": "PrismPath is a premium Laravel analytics, heatmap, session replay, and AI-assisted insight package.",
    "type": "library",
    "keywords": [
        "laravel",
        "analytics",
        "heatmaps",
        "session-replay",
        "prismpath",
        "google-analytics",
        "dashboard",
        "aetherpulse"
    ],
    "homepage": "https://github.com/aetherpulse/prismpath",
    "license": "MIT",
    "authors": [
        {
            "name": "PrismPath",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/aetherpulse/prismpath/issues",
        "source": "https://github.com/aetherpulse/prismpath"
    },
    "autoload": {
        "psr-4": {
            "UltraClarity\\Analytics\\": "src/",
            "UltraClarity\\Analytics\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "UltraClarity\\Analytics\\UltraClarityServiceProvider"
            ],
            "aliases": {
                "PrismPath": "UltraClarity\\Analytics\\Facades\\UltraClarity",
                "UltraClarity": "UltraClarity\\Analytics\\Facades\\UltraClarity"
            }
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

